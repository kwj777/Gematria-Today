{
  "name": "endtimes-neon-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "node scripts/check-static-analysis.mjs",
    "format:check": "node scripts/check-formatting.mjs",
    "test": "node --test tests/*.test.mjs",
    "count-lines": "find . -not -path './.git/*' -not -path './node_modules/*' -type f \\( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.mjs' -o -name '*.sql' -o -name '*.toml' -o -name '*.json' \\) -print0 | xargs -0 wc -l",
    "sync-root-pages": "node scripts/sync-root-pages.mjs --write",
    "check-root-pages": "node scripts/sync-root-pages.mjs --check",
    "audit:accessibility": "node scripts/accessibility-audit.mjs",
    "screenshot": "node scripts/capture-screenshot.mjs",
    "map:markdown-post": "node scripts/map-markdown-post.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^3.0.6",
    "playwright": "^1.54.2"
  }
}
