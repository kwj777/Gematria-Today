{
  "name": "gematria-neon-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "npm run build && npm run check:site-adaptation-guides && node scripts/check-static-analysis.mjs && node scripts/check-google-analytics.mjs && node scripts/check-no-inline-scripts.mjs && node scripts/check-partials.mjs && node scripts/sync-page-redirects.mjs --check && node scripts/build-site-bundle.mjs --check && node scripts/update-sitemap-lastmod.mjs --check",
    "build:bundle": "node scripts/build-site-bundle.mjs",
    "check:google-analytics": "node scripts/check-google-analytics.mjs",
    "format:check": "node scripts/check-formatting.mjs",
    "test": "node --test tests/*.test.mjs",
    "count-lines": "find . -not -path './.git/*' -not -path './node_modules/*' -type f \\( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.mjs' -o -name '*.sql' -o -name '*.toml' -o -name '*.json' \\) -print0 | xargs -0 wc -l",
    "check:partials": "node scripts/check-partials.mjs",
    "audit:accessibility": "node scripts/accessibility-audit.mjs",
    "screenshot": "node scripts/capture-screenshot.mjs",
    "preview:gemabot-modal": "node scripts/preview-gemabot-modal.mjs",
    "map:markdown-post": "node scripts/map-markdown-post.mjs",
    "sync:architect-guide": "npm run sync:site-adaptation-guides",
    "check:architect-guide": "npm run check:site-adaptation-guides",
    "sync:site-adaptation-guides": "node scripts/sync-site-adaptation-guides.mjs --write",
    "check:site-adaptation-guides": "node scripts/sync-site-adaptation-guides.mjs --check",
    "audit:redirects": "node scripts/audit-sitemap-redirects.mjs",
    "sync:sitemap": "node scripts/update-sitemap-lastmod.mjs --write",
    "check:sitemap": "node scripts/update-sitemap-lastmod.mjs --check",
    "build": "eleventy",
    "sync:redirects": "node scripts/sync-page-redirects.mjs --write",
    "check:redirects": "node scripts/sync-page-redirects.mjs --check",
    "audit:words": "node scripts/audit-words-table.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@neondatabase/serverless": "^0.9.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^3.0.6",
    "playwright": "1.56.0"
  }
}
