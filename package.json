{
  "name": "endtimes-neon-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "count-lines": "find . -not -path './.git/*' -not -path './node_modules/*' -type f \\( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.mjs' -o -name '*.sql' -o -name '*.toml' -o -name '*.json' \\) -print0 | xargs -0 wc -l",
    "sync-root-pages": "node scripts/sync-root-pages.mjs --write",
    "check-root-pages": "node scripts/sync-root-pages.mjs --check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0"
  }
}
